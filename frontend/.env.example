# Copy to .env.local (local) or set in Vercel. Only NEXT_PUBLIC_ values are visible in the browser.
# FastAPI backend (Render URL in production). The same-origin /api/backend proxy forwards to it.
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
# NextAuth.js v4 names (not Auth.js v5's AUTH_*)
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=
# Google OAuth web client (real mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
